# Environment contract for NoteDoctorAi.
#
# Names and purposes only — never commit real values. Copy to
# `.env.development.local` (or `.env.production.local`) and fill in.
#
# The deployed source of truth is Vercel (Production / Preview / Development).
# Keep this file in sync when you add or remove a variable, and check a running
# deployment with GET /api/debug (admin session required) — it reports every
# dependency below as a boolean plus an overall `publicApiReady`.

# --- AI -----------------------------------------------------------------
OPENAI_API_KEY=
AGENT_MODEL=                      # chat/agent model id (defaults to gpt-5)
SUMMARIZER_MODEL=                 # summarization model id (defaults to gpt-4o)
SERPAPI_API_KEY=                  # web-search fallback; read by the LangChain SDK
LANGCHAIN_PROJECT=                # optional tracing
LANGCHAIN_CALLBACKS_BACKGROUND=   # optional tracing

# --- Supabase -----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=
SUPABASE_URL=
SUPABASE_PRIVATE_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only; bypasses RLS — never expose

# --- Stripe -------------------------------------------------------------
# One secret key per environment. The environment decides live vs test:
# production must hold an sk_live_ key, or /api/debug reports
# `stripeKeyMode: false`. A test key in production silently targets the wrong
# Stripe account — customers resolve, webhooks never match, and no subscription
# is ever provisioned.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=            # must belong to THIS account's endpoint
STRIPE_SUBSCRIPTION_PRICE_ID=     # licensed (flat) price
STRIPE_METERED_PRICE_ID=          # metered (per-use) price
STRIPE_METER_EVENT_NAME=          # unset => requests served but never billed
STRIPE_BILLING_RETURN_URL=        # optional; falls back to NEXT_PUBLIC_SITE_URL

# --- URLs ---------------------------------------------------------------
# Required in every environment, not just production: it is the Stripe billing
# portal return_url and the redirect base for org invite emails. Unset, both
# silently degrade to an empty string.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BASE_URL_PROD=

# --- Upstash Redis ------------------------------------------------------
# Optional but load-bearing: when unset, every caller degrades silently —
# the rate limiter fails OPEN, the API-key auth cache is bypassed, and
# Idempotency-Key is ignored. Set these anywhere the public API is reachable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin --------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Tuning (optional) --------------------------------------------------
AGENT_RATE_LIMIT_PER_DAY=         # defaults to 200
